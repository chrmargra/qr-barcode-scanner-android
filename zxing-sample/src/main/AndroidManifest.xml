<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".fullscanner.FullScannerActivity"
            android:label="@string/scanner_activity"
            android:screenOrientation="portrait"
            android:theme="@style/AppOverlayTheme"
            android:uiOptions="splitActionBarWhenNarrow">

            <meta-data
                android:name="android.support.UI_OPTIONS"
                android:value="splitActionBarWhenNarrow" />
        </activity>

        <activity
            android:name=".fullscanner.FullScannerFragmentActivity"
            android:label="@string/scanner_fragment_activity"
            android:screenOrientation="portrait"
            android:theme="@style/AppOverlayTheme"
            android:uiOptions="splitActionBarWhenNarrow">

            <meta-data
                android:name="android.support.UI_OPTIONS"
                android:value="splitActionBarWhenNarrow" />
        </activity>

        <activity
            android:name=".simplescanner.SimpleScannerActivity"
            android:label="@string/simple_scanner_activity"
            android:screenOrientation="portrait"
            android:theme="@style/AppOverlayTheme" />

        <activity
            android:name=".simplescanner.SimpleScannerFragmentActivity"
            android:label="@string/simple_scanner_fragment_activity"
            android:screenOrientation="portrait"
            android:theme="@style/AppOverlayTheme" />

        <activity
            android:name=".fullscanner.FullScreenScannerFragmentActivity"
            android:label="@string/full_screen_scanner_fragment_activity"
            android:screenOrientation="portrait"
            android:theme="@style/AppOverlayTheme" />

        <activity
            android:name=".customviewfinder.CustomViewFinderScannerActivity"
            android:label="@string/custom_view_finder_scanner_activity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".scalingscanner.ScalingScannerActivity"
            android:label="@string/scaling_scanner_activity"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".qrcodegenerator.QRCodeGeneratorActivity"
            android:label="@string/qr_code_generator_sample"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme" />
    </application>
</manifest>
